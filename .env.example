# --- n8n (лише сервер; ніколи не потрапляють у браузер) ---
# Базова адреса вашого n8n, без слеша в кінці
N8N_BASE_URL=https://n8n.example.com
# Повна адреса production-webhook workflow «Адмінпанель: API керування співбесідами».
# Якщо не задана, використовується ${N8N_BASE_URL}/webhook/session-management
N8N_SESSION_MANAGEMENT_WEBHOOK_URL=https://n8n.example.com/webhook/session-management
# Той самий секрет, що в credential «Admin API secret (X-Webhook-Token)» у n8n
N8N_WEBHOOK_SECRET=change-me-long-random-string
# Тайм-аут запиту до n8n, мс (необов'язково, типово 15000)
N8N_REQUEST_TIMEOUT_MS=15000

# --- Вхід в адмінпанель (один спільний логін і пароль для команди) ---
ADMIN_LOGIN=team
ADMIN_PASSWORD=change-me-strong-password
# Ключ підпису cookie сесії, щонайменше 32 символи. Згенерувати: openssl rand -base64 48
# Зміна ключа, логіна чи пароля завершує всі активні сесії.
ADMIN_SESSION_SECRET=change-me-another-long-random-string-at-least-32-chars
