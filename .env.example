# --- База даних PostgreSQL (лише сервер; ніколи не потрапляє у браузер) ---
# На Railway в тому ж проєкті, що й база: внутрішня адреса (postgres.railway.internal).
# Деінде (локально, інший проєкт / хостинг): публічна адреса (…proxy.rlwy.net:порт).
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
# Публічна адреса: локально використовується замість внутрішньої автоматично
DATABASE_PUBLIC_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:49362/railway

# --- KeyCRM Open API: ліди «Запросили на 1 тур» і запис часу співбесіди (LD_1027) ---
# Той самий ключ API KeyCRM, що в n8n credential «Bearer Auth account 3»
KEYCRM_API_KEY=change-me

# --- Вхід в адмінпанель (один спільний логін і пароль для команди) ---
ADMIN_LOGIN=team
ADMIN_PASSWORD=change-me-strong-password
# Ключ підпису cookie сесії, щонайменше 32 символи. Згенерувати: openssl rand -base64 48
# Зміна ключа, логіна чи пароля завершує всі активні сесії.
ADMIN_SESSION_SECRET=change-me-another-long-random-string-at-least-32-chars

# Необов'язково: секрет в адресі webhook голосового агента (?token=…). Не задано — webhook відкритий.
VOICE_AGENT_WEBHOOK_TOKEN=
