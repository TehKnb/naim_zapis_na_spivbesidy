      "parameters": {
        "jsCode": "// Рядки Data Table: { id (автоінкремент), createdAt, updatedAt, ...колонки }. Порожній результат = [{}].\nconst rows = (items) => items.map((i) => i.json).filter((j) => j && j.id !== undefined && j.id !== null);\n\nconst list = rows($input.all()).filter((s) => !s.pipeline_name && (s.pipeline_id === null || s.pipeline_id === undefined || s.pipeline_id === ''));\nreturn list.map((s) => ({ json: { session_id: s.session_id, session_name: s.session_name } }));\n"
      },
